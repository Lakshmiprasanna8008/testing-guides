{
  "manifest_version": 3,
  "name": "SAP CPI Guider",
  "version": "1.2.0",
  "description": "Monitor, trace and debug SAP Cloud Integration iFlows on any tenant: messages, errors, payloads, red/green step overlay, themes.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "SAP CPI Guider - open on this page",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/itspaces/*",
        "https://*/shell/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
